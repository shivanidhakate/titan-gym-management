# ============================================================
# Titan Gym Management System — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── JWT ──────────────────────────────────────────────────────
# Generate a long random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRE=30d

# ── MongoDB ───────────────────────────────────────────────────
# Leave blank to run in Mock (in-memory) mode.
# MongoDB Atlas example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/gymdb?retryWrites=true&w=majority
MONGO_URI=

# ── Cloudinary ───────────────────────────────────────────────
# Create a free account at https://cloudinary.com
# Leave blank to skip cloud uploads (profile photos won't be saved).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay ─────────────────────────────────────────────────
# Create a free test account at https://razorpay.com
# Leave blank to use the built-in mock payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
